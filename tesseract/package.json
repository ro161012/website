{
  "name": "tesseract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An independent, privacy-first grade tracker for Home Access Center.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
