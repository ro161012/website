# ---------------------------------------------------------------------------
# Tesseract environment
#
# Copy this file to `.env.local` for local development. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# 32 random bytes (or more), base64 or hex encoded. Used to encrypt the HAC
# session cookie with AES-256-GCM. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Optional. District HAC address used by the password-only sign-in form.
# Defaults to the built-in Round Rock ISD HAC when unset.
HAC_DISTRICT_URL=https://accesscenter.roundrockisd.org/HomeAccess

# Optional. Comma-separated host suffixes that Tesseract may contact. When empty,
# the default SSRF guard (HTTPS only, public hosts only) applies to every URL.
# Example: HAC_ALLOWED_HOST_SUFFIXES=access.example.k12.us,hac.example.org
HAC_ALLOWED_HOST_SUFFIXES=

# Optional. Force one configured profile for every district, or describe
# district-specific profiles as a JSON array. Paths, selectors and quirk keys
# merge over the generic HAC profile; unknown keys are rejected.
# HAC_PROFILE=our-district
# HAC_PROFILES=[{"id":"our-district","label":"Our district","matchHosts":["hac.example.k12.us"],"paths":{"schedule":"/HomeAccess/Content/Student/Classes.aspx"},"selectors":{"assignment":"div.AssignmentClass"}}]

# Absolute origin of this deployment, used for same-origin checks and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
